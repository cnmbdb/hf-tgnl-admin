# ================== 域名配置（三个核心域名）==================
# 1. 后台域名 = cftun app 隧道域名
DOMAIN_NAME=tgnl-admin-app.域名

# 2. 授权/能量池平台域名
ENERGY_POOL_API_URL=https://tgnl-home.aloure-web.top
LICENSE_API_URL=https://tgnl-home.aloure-web.top

# 3. 机器人 Webhook 域名 = cftun bot 隧道域名
BOT_WEBHOOK_URL=https://tgnl-admin-bot.域名
BOT_SERVER_PUBLIC_URL=https://tgnl-admin-bot.域名
# 留空则自动使用 BOT_SERVER_PUBLIC_URL/api/recharge-notify
BOT_NOTIFY_URL=

# ================== 初始管理员（首次部署自动创建）==================
# 如果数据库中没有管理员，启动时自动创建
INIT_ADMIN_USER=admin
INIT_ADMIN_PASS=admin123
INIT_ADMIN_EMAIL=admin@example.com

# ================== 数据库配置 ==================
DB_HOST=db
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
MYSQL_ROOT_PASSWORD=root
DB_NAME=tgnl
MYSQL_DATABASE=tgnl

# ================== 应用基础配置 ==================
