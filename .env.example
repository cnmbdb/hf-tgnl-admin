# ================== 域名配置 ==================
DOMAIN_NAME=your-admin-domain.com
BOT_WEBHOOK_URL=https://your-bot-domain.com
BOT_SERVER_PUBLIC_URL=https://your-bot-domain.com

# ================== Cloudflare Turnstile ==================
NUXT_PUBLIC_TURNSTILE_SITE_KEY=your_site_key
TURNSTILE_SECRET_KEY=your_secret_key

# ================== Cloudflare Tunnel ==================
CFTUN_TUNNEL_ID=your_tunnel_id
CFTUN_TOKEN=your_cftun_token

# ================== 平台域名 ==================
ENERGY_POOL_API_URL=https://tgnl-home.aloure-web.top
LICENSE_API_URL=https://tgnl-home.aloure-web.top

# ================== 访问控制 ==================
ENFORCE_HOST_CHECK=false
ALLOW_IP_ACCESS=true
ALLOWED_HOSTS=localhost,127.0.0.1
BOT_NOTIFY_URL=

# ================== Bot Token & 账号 ==================
BOT_TOKEN=your_telegram_bot_token
BOT_API_USERNAME=your_username
BOT_API_PASSWORD=your_password
BOT_PRIVATE_KEY=your_private_key
USDT2TRX_PRIVATE_KEY=your_private_key
CONTROL_ADDRESS=your_tron_address
CUSTOMER_SERVICE_ID=https://t.me/your_service
BOT_ID=https://t.me/your_bot
GROUP_LINK=https://t.me/your_group

# ================== 初始管理员 ==================
INIT_ADMIN_USER=admin
INIT_ADMIN_PASS=admin123
INIT_ADMIN_EMAIL=admin@example.com

# ================== 数据库配置 ==================
DB_HOST=db
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
MYSQL_ROOT_PASSWORD=your_db_password
DB_NAME=tgnl
MYSQL_DATABASE=tgnl

# ================== 价格配置（TRX）==================
BOT_HOUR_PRICE=0.5
BOT_DAY_PRICE=3
BOT_THREE_DAY_PRICE=3
BOT_BISHU_5_PRICE=11
BOT_BISHU_15_PRICE=20
BOT_BISHU_50_PRICE=45
BOT_BISHU_100_PRICE=100

# ================== Bot 运行参数 ==================
BOT_ADMIN_ID=your_telegram_id
BOT_AD_TIME=940
BOT_HUILV_ZHEKOU=0.90
BOT_WEBHOOK_PORT=8443
BOT_WEBHOOK_PATH=webhook

# ================== 应用基础配置 ==================
APP_BASE_PATH=/admin
PORT=3000
APP_HOST=app
BIND_IP=127.0.0.1
NODE_ENV=production

# ================== Tron ==================
TRON_API_KEY=your_tron_api_key

# ================== 其他 ==================
TZ=Asia/Shanghai
NUXT_PUBLIC_SITE_TITLE=Your Site Title
NUXT_PUBLIC_ROBOTS_INDEX=false
APP_VERSION=2026.4.12

# ================== 容器名称 ==================
APP_CONTAINER_NAME=tgnl-admin-app
BOT_CONTAINER_NAME=tgnl-admin-bot
CFTUN_CONTAINER_NAME=tgnl-admin-cftun
DB_CONTAINER_NAME=tgnl-admin-db
